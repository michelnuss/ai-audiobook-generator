# Microsoft Foundry (Azure) — Claude deployment
ANTHROPIC_FOUNDRY_API_KEY=
# Your Foundry resource name (the part before .services.ai.azure.com) ...
ANTHROPIC_FOUNDRY_RESOURCE=
# ... or the full endpoint instead of the resource name
ANTHROPIC_FOUNDRY_BASE_URL=

# Model deployment name in Foundry
TRANSLATION_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high | xhigh | max
TRANSLATION_EFFORT=high
REVIEW_EFFORT=xhigh

# Optional overrides (paths are relative to this folder)
SOURCE_DOCX=Ilana-Livro-LIMPO colorido (1).docx
OUTPUT_DOCX=output/Ilana-Book-EN.docx
MAX_CHUNK_WORDS=2500
CONTEXT_PARAGRAPHS=40
MAX_OUTPUT_TOKENS=64000
